<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DuxiuLedger.WinUI.BudgetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="分类预算"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
  <StackPanel Width="420" Spacing="12">
    <CalendarDatePicker x:Name="MonthPicker" Header="预算月份" />
    <ComboBox x:Name="CategoryBox" Header="支出分类" IsEditable="True" />
    <NumberBox x:Name="AmountBox" Header="预算金额（元）" Minimum="0.01" SpinButtonPlacementMode="Compact" />
    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Message="同一月份和分类只保留一条预算，再次保存会更新原金额。" />
  </StackPanel>
</ContentDialog>
