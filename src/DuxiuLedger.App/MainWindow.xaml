                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="S3RegionBox" Header="区域 Region" PlaceholderText="us-east-1" />
                        <TextBox x:Name="S3BucketBox" Grid.Column="1" Header="Bucket 手动覆盖" PlaceholderText="无法自动识别时填写" />
                      </Grid>
                      <TextBox x:Name="S3ObjectKeyBox" Header="同步对象路径" PlaceholderText="duxiu-ledger/sync-v1.json" />
                      <PasswordBox x:Name="S3SessionTokenBox" Header="Session Token（可选，临时凭据使用）" PasswordRevealMode="Peek" />
                      <CheckBox x:Name="S3ForcePathStyleCheck" Content="使用 Path Style 地址（MinIO 等服务通常需要）" />
                    </StackPanel>
                  </Expander>
                  <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Message="例如访问地址为 https://zxx.cn-nb1.rains3.com、API 端点为 https://cn-nb1.rains3.com 时，会自动识别 Bucket 为 zxx。" />
                  <ProgressRing x:Name="CloudSyncProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                  <InfoBar x:Name="CloudSyncInfo" IsOpen="False" IsClosable="True" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保存并测试连接" Click="TestS3Click" />
                    <Button Content="立即双向同步" Style="{StaticResource AccentButtonStyle}" Click="SyncNowClick" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="BackupPage" Style="{StaticResource CardStyle}" Padding="28" Visibility="Collapsed">
            <StackPanel Width="560" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="12">
              <FontIcon Glyph="" FontSize="30" HorizontalAlignment="Left" />
              <TextBlock Text="保护你的本地数据" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="账本数据保存在本机应用数据文件中，也可以在偏好设置中配置 S3 对象存储同步。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="立即备份" Style="{StaticResource AccentButtonStyle}" Click="BackupClick" />
                <Button Content="打开数据目录" Click="OpenDataFolderClick" />
              </StackPanel>
              <TextBlock x:Name="DataPathText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="PlaceholderPage" Style="{StaticResource CardStyle}" Padding="24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
              <FontIcon Glyph="" FontSize="32" />
              <TextBlock x:Name="PlaceholderTitle" Text="页面建设中" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="该模块将在后续开发中接入。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="WinUI 3 · 本地优先" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="2,12,0,0" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
