<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DuxiuLedger.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="using:DuxiuLedger.Desktop.Models" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="独秀账本" mc:Ignorable="d">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>
  <Grid AllowDrop="True" DragOver="ScreenshotDragOver" Drop="ScreenshotDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="独秀账本" Subtitle="个人财务中心" IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBarPaneToggleRequested">
      <TitleBar.IconSource>
        <BitmapIconSource UriSource="ms-appx:///Assets/duxiu-logo.png" ShowAsMonochrome="False" />
      </TitleBar.IconSource>
    </TitleBar>
    <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="232" SelectionChanged="NavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="总览" Tag="Dashboard" IsSelected="True">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="全部流水" Tag="Transactions">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="消费洞察" Tag="Insights">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="预算计划" Tag="Budgets">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="订阅与月卡" Tag="Subscriptions">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="账户管理" Tag="Accounts">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="分类设置" Tag="Categories">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="数据备份" Tag="Backup">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="偏好设置" Tag="Settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid Padding="32,24,32,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="总览" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="PageSubtitle" Text="查看本月财务情况和最近流水" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
            <Button Content="导入表格" Click="ImportClick" />
            <Button Content="识别账单截图" Click="ScreenshotImportClick" />
            <Button Content="粘贴截图" ToolTipService.ToolTip="从剪贴板粘贴图片，快捷键 Ctrl+V" Click="PasteScreenshotClick">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteScreenshotAcceleratorInvoked" />
              </Button.KeyboardAccelerators>
            </Button>
            <Button Content="新增记录" Style="{StaticResource AccentButtonStyle}" Click="AddClick" />
          </StackPanel>
        </Grid>
        <Grid x:Name="ContentHost" Grid.Row="1" Margin="0,22,0,0">
          <Grid x:Name="DashboardPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                  <TextBlock Text="本月收入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock x:Name="IncomeText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                  <TextBlock Text="本月净支出" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock x:Name="ExpenseText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="支出扣除退款与报销" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                  <TextBlock Text="本月结余" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock x:Name="BalanceText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="最近流水" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock x:Name="RecordCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" />
                </StackPanel>
                <ListView x:Name="RecentList" Grid.Row="1" SelectionMode="None">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionRecord">
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                          </Grid.ColumnDefinitions>
                          <Border Width="3" CornerRadius="2" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                          <TextBlock Grid.Column="1" Text="{x:Bind DateDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          <Border Grid.Column="2" Padding="9,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionBackground}">
                            <TextBlock Text="{x:Bind Direction}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                          </Border>
                          <TextBlock Grid.Column="3" Text="{x:Bind SignedAmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                          <TextBlock Grid.Column="4" Text="{x:Bind Merchant}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="5" Padding="9,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBackground}" BorderBrush="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBorder}" BorderThickness="1">
                            <TextBlock Text="{x:Bind Category}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Grid>
            </Border>
          </Grid>
          <SplitView x:Name="TransactionsPage" Visibility="Collapsed" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="370" CompactPaneLength="0">
            <SplitView.Pane>
              <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid>
                    <StackPanel><TextBlock Text="筛选流水" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="同一组内多选为“或者”，不同组之间为“并且”" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="关闭筛选" Click="CloseTransactionFiltersClick" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" Margin="0,18,0,12">
                    <StackPanel Spacing="15">
                      <StackPanel Spacing="8">
                        <TextBlock Text="自定义日期" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CalendarDatePicker x:Name="TransactionStartDatePicker" PlaceholderText="开始日期" /><CalendarDatePicker x:Name="TransactionEndDatePicker" Grid.Column="1" PlaceholderText="结束日期" /></Grid>
                      </StackPanel>
                      <StackPanel Spacing="8">
                        <TextBlock Text="收支类型（可多选）" FontWeight="SemiBold" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><CheckBox x:Name="FilterExpenseCheck" Content="支出" /><CheckBox x:Name="FilterIncomeCheck" Grid.Column="1" Content="收入" /><CheckBox x:Name="FilterTransferCheck" Grid.Column="2" Content="转账" /><CheckBox x:Name="FilterRefundCheck" Grid.Row="1" Content="退款" /><CheckBox x:Name="FilterReimbursementCheck" Grid.Row="1" Grid.Column="1" Content="报销" /></Grid>
                      </StackPanel>
                      <StackPanel Spacing="7">
                        <TextBlock Text="分类（可多选）" FontWeight="SemiBold" />
                        <TextBox x:Name="TransactionCategorySearchBox" PlaceholderText="搜索分类" TextChanged="TransactionCategorySearchChanged" />
                        <ListView x:Name="TransactionCategoryFilterList" SelectionMode="None" MaxHeight="170">
                          <ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                      </StackPanel>
                      <StackPanel Spacing="7">
                        <TextBlock Text="账户（可多选）" FontWeight="SemiBold" />
                        <TextBox x:Name="TransactionAccountSearchBox" PlaceholderText="搜索账户" TextChanged="TransactionAccountSearchChanged" />
                        <ListView x:Name="TransactionAccountFilterList" SelectionMode="None" MaxHeight="150">
                          <ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                      </StackPanel>
                      <StackPanel Spacing="7">
                        <TextBlock Text="金额范围" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="TransactionMinimumAmountBox" Header="最低金额" Minimum="0" PlaceholderText="不限" /><NumberBox x:Name="TransactionMaximumAmountBox" Grid.Column="1" Header="最高金额" Minimum="0" PlaceholderText="不限" /></Grid>
                      </StackPanel>
                      <StackPanel Spacing="7">
                        <TextBlock Text="导入来源（可多选）" FontWeight="SemiBold" />
                        <ListView x:Name="TransactionSourceFilterList" SelectionMode="None" MaxHeight="140">
                          <ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text="特殊条件" FontWeight="SemiBold" />
                        <CheckBox x:Name="TransactionUncategorizedCheck" Content="只看未分类" />
                        <CheckBox x:Name="TransactionSubscriptionCheck" Content="只看订阅消费" />
                        <CheckBox x:Name="TransactionUnassignedAccountCheck" Content="只看未指定账户" />
                      </StackPanel>
                      <ComboBox x:Name="TransactionSortBox" Header="排序方式" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="时间：新到旧" /><ComboBoxItem Content="时间：旧到新" /><ComboBoxItem Content="金额：高到低" /><ComboBoxItem Content="金额：低到高" /><ComboBoxItem Content="商户：A 到 Z" />
                      </ComboBox>
                    </StackPanel>
                  </ScrollViewer>
                  <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="重置全部" HorizontalAlignment="Stretch" Click="ResetTransactionFiltersClick" /><Button Grid.Column="1" Content="应用筛选" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="ApplyTransactionFiltersClick" /></Grid>
                </Grid>
              </Border>
            </SplitView.Pane>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="TransactionsSearchBox" PlaceholderText="搜索商户、备注、分类、账户或来源" QueryIcon="Find" TextChanged="TransactionsSearchTextChanged" QuerySubmitted="TransactionsSearchSubmitted" />
                <ComboBox x:Name="TransactionDatePresetBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="TransactionDatePresetChanged"><ComboBoxItem Content="全部时间" /><ComboBoxItem Content="本月" /><ComboBoxItem Content="上月" /><ComboBoxItem Content="最近 7 天" /><ComboBoxItem Content="最近 30 天" /><ComboBoxItem Content="本年度" /><ComboBoxItem Content="自定义日期" /></ComboBox>
                <Button x:Name="DirectionFilterButton" Grid.Column="2" Content="收支类型" Click="OpenTransactionFiltersClick" />
                <Button x:Name="CategoryFilterButton" Grid.Column="3" Content="分类" Click="OpenTransactionFiltersClick" />
                <Button x:Name="AccountFilterButton" Grid.Column="4" Content="账户" Click="OpenTransactionFiltersClick" />
                <Button x:Name="MoreTransactionFiltersButton" Grid.Column="5" Content="更多筛选" Click="OpenTransactionFiltersClick" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,10,0,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ItemsControl x:Name="TransactionFilterChipsControl" HorizontalAlignment="Left">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Margin="0,0,7,6" Padding="10,5" Click="RemoveTransactionFilterChipClick" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ClearAllTransactionFiltersButton" Grid.Column="1" Content="清除全部" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetTransactionFiltersClick" />
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,10" ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="FilteredTransactionCountText" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="FilteredExpenseText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FilteredIncomeText" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FilteredRefundText" Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FilteredBalanceText" Grid.Column="4" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Grid Padding="12,8" ColumnSpacing="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="130" /><ColumnDefinition Width="74" /><ColumnDefinition Width="104" /><ColumnDefinition Width="116" /><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="时间 ↕" Padding="4,2" HorizontalAlignment="Left" Click="SortTransactionsByDateClick" /><TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="3" Content="金额 ↕" Padding="4,2" HorizontalAlignment="Left" Click="SortTransactionsByAmountClick" /><TextBlock Grid.Column="4" Text="分类" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="账户" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="6" Content="商户 ↕" Padding="4,2" HorizontalAlignment="Left" Click="SortTransactionsByMerchantClick" /><TextBlock Grid.Column="7" Text="备注" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Grid>
                  <ListView x:Name="TransactionsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TransactionItemClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Grid Padding="12,9,12,6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"><TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="models:TransactionRecord">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                          <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="编辑流水" Tag="{x:Bind}" Click="EditTransactionMenuClick" /><MenuFlyoutItem Text="删除流水" Tag="{x:Bind}" Click="DeleteTransactionMenuClick" /></MenuFlyout></Border.ContextFlyout>
                          <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="130" /><ColumnDefinition Width="74" /><ColumnDefinition Width="104" /><ColumnDefinition Width="116" /><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="2" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DateDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Grid.Column="2" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionBackground}"><TextBlock Text="{x:Bind Direction}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" /></Border>
                            <TextBlock Grid.Column="3" Text="{x:Bind SignedAmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                            <Border Grid.Column="4" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBackground}" BorderBrush="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBorder}" BorderThickness="1"><TextBlock Text="{x:Bind Category}" FontSize="12" TextTrimming="CharacterEllipsis" /></Border>
                            <TextBlock Grid.Column="5" Text="{x:Bind AccountDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{x:Bind Merchant}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Merchant}" />
                            <TextBlock Grid.Column="7" Text="{x:Bind Note}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Note}" />
                            <Button Grid.Column="8" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" ToolTipService.ToolTip="更多操作"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="编辑流水" Tag="{x:Bind}" Click="EditTransactionMenuClick" /><MenuFlyoutItem Text="删除流水" Tag="{x:Bind}" Click="DeleteTransactionMenuClick" /></MenuFlyout></Button.Flyout></Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <StackPanel x:Name="TransactionsEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="34" /><TextBlock Text="没有找到符合条件的流水" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="尝试修改关键词或清除部分筛选条件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Content="清除全部筛选" HorizontalAlignment="Center" Click="ResetTransactionFiltersClick" /></StackPanel>
                </Grid>
              </Border>
            </Grid>
          </SplitView>
          <ScrollViewer x:Name="InsightsPage" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="0,0,4,18">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="周期财务总结" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="从收支、结余、消费结构与变化趋势理解钱的去向" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox x:Name="AnalysisPeriodBox" Width="104" SelectedIndex="1" SelectionChanged="AnalysisPeriodChanged">
                    <ComboBoxItem Content="周度" />
                    <ComboBoxItem Content="月度" />
                    <ComboBoxItem Content="年度" />
                  </ComboBox>
                  <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons" ToolTipService.ToolTip="上一个周期" Click="AnalysisPreviousClick" />
                  <Button Content="本期" Click="AnalysisTodayClick" />
                  <Button x:Name="AnalysisNextButton" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" ToolTipService.ToolTip="下一个周期" Click="AnalysisNextClick" />
                  <Button Content="导出 CSV" Click="ExportAnalysisReportClick" />
                </StackPanel>
              </Grid>

              <TextBlock x:Name="AnalysisRangeText" Text="当前统计周期" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                  <StackPanel Spacing="6">
                    <TextBlock Text="收入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AnalysisIncomeText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="不含转账与退款" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                  <StackPanel Spacing="6">
                    <TextBlock Text="净支出" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AnalysisExpenseText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="AnalysisExpenseDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                  <StackPanel Spacing="6">
                    <TextBlock Text="结余" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AnalysisBalanceText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="收入减去净支出" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18">
                  <StackPanel Spacing="6">
                    <TextBlock Text="储蓄率" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AnalysisSavingsRateText" Text="0%" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="AnalysisSavingsDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="5">
