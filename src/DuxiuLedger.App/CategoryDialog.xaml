<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DuxiuLedger.WinUI.CategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新增分类"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
  <StackPanel Width="420" Spacing="12">
    <TextBox x:Name="NameBox" Header="分类名称" PlaceholderText="例如：健身运动" />
    <ComboBox x:Name="TypeBox" Header="分类用途" HorizontalAlignment="Stretch" />
    <NumberBox x:Name="SortOrderBox" Header="排序数字（越小越靠前）" Minimum="0" SpinButtonPlacementMode="Compact" />
    <ToggleSwitch x:Name="ActiveSwitch" Header="分类状态" OnContent="使用中" OffContent="已停用" IsOn="True" />
    <InfoBar x:Name="ValidationInfo" IsOpen="False" Severity="Error" IsClosable="False" />
  </StackPanel>
</ContentDialog>
