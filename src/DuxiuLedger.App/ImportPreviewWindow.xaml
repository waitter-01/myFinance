<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuxiuLedger.WinUI.ImportPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DuxiuLedger.Desktop.Models"
    Title="账单导入预览">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>

  <Grid x:Name="WindowRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" SizeChanged="WindowRootSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="ImportTitleBar" Padding="16,0" Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Image Source="ms-appx:///Assets/duxiu-logo.png" Width="24" Height="24" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="10,0,0,0">
        <TextBlock Text="账单导入预览" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="可拖动、缩放或最大化窗口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid x:Name="SummaryLayout" Grid.Row="1" Margin="20,14,20,0" ColumnSpacing="10" RowSpacing="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SummaryColumn0" Width="*" />
        <ColumnDefinition x:Name="SummaryColumn1" Width="*" />
        <ColumnDefinition x:Name="SummaryColumn2" Width="*" />
        <ColumnDefinition x:Name="SummaryColumn3" Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="FileSummaryCard" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14">
        <StackPanel><TextBlock Text="文件 / 识别记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="FileCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
      </Border>
      <Border x:Name="ValidSummaryCard" Grid.Column="1" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14">
        <StackPanel><TextBlock Text="待导入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ValidCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
      </Border>
      <Border x:Name="DuplicateSummaryCard" Grid.Column="2" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14">
        <StackPanel Spacing="7"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="疑似重复" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DuplicateCountText" FontWeight="SemiBold" /></StackPanel><Button x:Name="DuplicateSummaryButton" Content="查看并处理 →" HorizontalAlignment="Left" Click="ShowDuplicatesClick" /></StackPanel>
      </Border>
      <Border x:Name="IssueSummaryCard" Grid.Column="3" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14">
        <StackPanel Spacing="7"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="需要核对" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="IssueCountText" FontWeight="SemiBold" /></StackPanel><Button x:Name="IssueSummaryButton" Content="查看并修正 →" HorizontalAlignment="Left" Click="ShowIssuesClick" /></StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="AccountLayout" Grid.Row="2" Margin="20,12,20,10" ColumnSpacing="12" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ComboBox x:Name="AccountBox" Header="导入到账户" DisplayMemberPath="Name" />
      <InfoBar x:Name="DuplicateInfoBar" Grid.Column="1" IsOpen="True" IsClosable="False" Severity="Informational" Message="疑似重复记录默认不会导入；请在“疑似重复”页核对，确为两笔交易时可选择仍然导入。" />
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="12" Margin="20,0,20,10">
      <Grid x:Name="EditLayout" ColumnSpacing="10" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="EditDirectionBox" Grid.ColumnSpan="2" Header="收支类型" IsEnabled="False" />
        <NumberBox x:Name="EditAmountBox" Grid.Column="2" Grid.ColumnSpan="2" Header="金额" Minimum="0.01" IsEnabled="False" />
        <ComboBox x:Name="EditCategoryBox" Grid.Column="4" Grid.ColumnSpan="2" Header="分类" IsEditable="True" IsEnabled="False" />
        <TextBox x:Name="EditMerchantBox" Grid.Column="6" Grid.ColumnSpan="3" Header="交易对方" IsEnabled="False" />
        <TextBox x:Name="EditDateBox" Grid.Column="9" Grid.ColumnSpan="2" Header="时间" PlaceholderText="yyyy-MM-dd HH:mm" IsEnabled="False" />
        <StackPanel x:Name="EditActions" Grid.Row="1" Grid.ColumnSpan="12" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
          <Button x:Name="ApplyEditButton" Content="应用修正" Click="ApplyEditClick" IsEnabled="False" />
          <Button x:Name="RemoveRowButton" Content="跳过此条" Click="RemoveRowClick" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>

    <TabView x:Name="ImportTabs" Grid.Row="4" Margin="20,0" IsAddTabButtonVisible="False" CornerRadius="10">
      <TabViewItem x:Name="PendingTab" Header="待导入流水" IsClosable="False">
        <Grid MinHeight="160">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="76" /><ColumnDefinition Width="105" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="194" /></Grid.ColumnDefinitions>
            <TextBlock Text="交易时间" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="类型" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="金额" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="分类" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="交易对方" FontWeight="SemiBold" /><Button x:Name="ScrollToLastButton" Grid.Column="5" Content="查看最后一条 ↓" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ScrollToLastClick" />
          </Grid>
          <ListView x:Name="RecordsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="RecordsSelectionChanged" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:TransactionRecord">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,9" MinWidth="900">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="76" /><ColumnDefinition Width="105" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="194" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DateDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionBackground}"><TextBlock Text="{x:Bind Direction}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" /></Border>
                    <TextBlock Grid.Column="2" Text="{x:Bind SignedAmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                    <Border Grid.Column="3" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBackground}" BorderBrush="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBorder}" BorderThickness="1"><TextBlock Text="{x:Bind Category}" FontSize="12" TextTrimming="CharacterEllipsis" /></Border>
                    <TextBlock Grid.Column="4" Text="{x:Bind Merchant}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Merchant}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind PreviewSourceDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PreviewSourceDisplay}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </TabViewItem>
      <TabViewItem x:Name="DuplicateTab" Header="疑似重复（需要确认）" IsClosable="False">
        <Grid MinHeight="160">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="12" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3"><TextBlock Text="这些记录与账本已有数据或本批次其他记录相似，默认跳过" FontWeight="SemiBold" /><TextBlock Text="选择一条记录并点击“仍然导入”，可保留时间和金额恰好相同的真实两笔交易。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
            <Button Grid.Column="1" Content="仍然导入所选" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ImportDuplicateClick" />
          </Grid>
          <ListView x:Name="DuplicateList" Grid.Row="1" SelectionMode="Single" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:ImportDuplicateItem"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10"><StackPanel Spacing="4"><TextBlock Text="{x:Bind IncomingDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ExistingDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Reason}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </TabViewItem>
      <TabViewItem x:Name="IssuesTab" Header="需要核对（可修改）" IsClosable="False">
        <Grid MinHeight="160">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="识别结果需要人工核对" Message="点击“定位并修改”后修正或跳过该条；问题处理完成前不能确认导入。" />
          <ListView x:Name="IssuesList" Grid.Row="1" SelectionMode="None" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:ImportIssue"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10" MinWidth="850"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="80" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Source}" /><TextBlock Grid.Column="1" Text="{x:Bind RowDisplay}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{x:Bind Reason}" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="{x:Bind RawValue}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><Button Grid.Column="4" Content="{x:Bind ReviewActionText}" Tag="{x:Bind}" IsEnabled="{x:Bind CanReview}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ReviewIssueClick" /></Grid></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Grid>
      </TabViewItem>
    </TabView>

    <Grid x:Name="FooterLayout" Grid.Row="5" Margin="20,12,20,18" ColumnSpacing="12" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="ImportHintText" Text="确认前请核对金额、时间和收支类型；取消不会写入账本。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="取消" MinWidth="96" Click="CancelClick" />
        <Button x:Name="ConfirmButton" Content="确认导入" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="ConfirmClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
