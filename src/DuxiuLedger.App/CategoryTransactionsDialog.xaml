<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DuxiuLedger.WinUI.CategoryTransactionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DuxiuLedger.Desktop.Models"
    CloseButtonText="关闭"
    DefaultButton="Close">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
  </ContentDialog.Resources>
  <Grid Width="820" MinHeight="360" MaxHeight="620" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
      <TextBlock Text="时间" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="金额" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="账户" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="交易对方" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="备注" FontWeight="SemiBold" />
    </Grid>
    <ListView Grid.Row="2" ItemsSource="{x:Bind Rows}" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:TransactionRecord">
          <Border Padding="12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind DateDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Bind SignedAmountDisplay}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
              <TextBlock Grid.Column="2" Text="{x:Bind AccountDisplay}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{x:Bind Merchant}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Merchant}" />
              <TextBlock Grid.Column="4" Text="{x:Bind Note}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Note}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
