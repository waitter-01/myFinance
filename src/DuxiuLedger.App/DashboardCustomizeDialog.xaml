<ContentDialog
    x:Class="DuxiuLedger.WinUI.DashboardCustomizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DuxiuLedger.WinUI"
    Title="自定义总览"
    PrimaryButtonText="保存布局"
    CloseButtonText="取消"
    DefaultButton="Primary">
  <Grid Width="560" MinHeight="390" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="勾选要显示的模块，使用箭头调整它们在总览中的上下顺序。核心数据会继续保存在本地，不受隐藏影响。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <ListView x:Name="CardsList" Grid.Row="1" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:DashboardCardOption">
          <Grid Padding="8" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
            <Button Grid.Column="2" Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="MoveUpClick" ToolTipService.ToolTip="上移" />
            <Button Grid.Column="3" Content="&#xE74B;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" Click="MoveDownClick" ToolTipService.ToolTip="下移" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
