<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DuxiuLedger.WinUI.ImportPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DuxiuLedger.Desktop.Models"
    Title="账单导入预览"
    PrimaryButtonText="确认导入"
    CloseButtonText="取消"
    DefaultButton="Primary"
    CornerRadius="12"
    BorderThickness="1"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    PrimaryButtonClick="OnPrimaryButtonClick">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMinWidth">1100</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">1220</x:Double>
  </ContentDialog.Resources>
  <Grid Width="1120" Height="650">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="FileCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="待导入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ValidCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="疑似重复" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DuplicateCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel><Button x:Name="DuplicateSummaryButton" Grid.Column="1" Content="查看并处理 →" VerticalAlignment="Center" Click="ShowDuplicatesClick" /></Grid></Border>
      <Border Grid.Column="3" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="问题行" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="IssueCountText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox x:Name="AccountBox" Header="导入到账户" DisplayMemberPath="Name" /><InfoBar Grid.Column="1" IsOpen="True" IsClosable="False" Severity="Informational" Message="疑似重复记录默认不会导入；请在“疑似重复”页核对，确为两笔交易时可选择仍然导入。" /></Grid>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="165" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ComboBox x:Name="EditDirectionBox" Header="收支类型" IsEnabled="False" />
        <NumberBox x:Name="EditAmountBox" Grid.Column="1" Header="金额" Minimum="0.01" IsEnabled="False" />
        <ComboBox x:Name="EditCategoryBox" Grid.Column="2" Header="分类" IsEditable="True" IsEnabled="False" />
        <TextBox x:Name="EditMerchantBox" Grid.Column="3" Header="交易对方" IsEnabled="False" />
        <TextBox x:Name="EditDateBox" Grid.Column="4" Header="时间" PlaceholderText="yyyy-MM-dd HH:mm" IsEnabled="False" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom"><Button x:Name="ApplyEditButton" Content="应用修正" Click="ApplyEditClick" IsEnabled="False" /><Button x:Name="RemoveRowButton" Content="跳过此条" Click="RemoveRowClick" IsEnabled="False" /></StackPanel>
      </Grid>
    </Border>
    <TabView x:Name="ImportTabs" Grid.Row="3" IsAddTabButtonVisible="False" CornerRadius="10">
      <TabViewItem x:Name="PendingTab" Header="待导入流水" IsClosable="False">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="76" /><ColumnDefinition Width="105" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="194" /></Grid.ColumnDefinitions>
            <TextBlock Text="交易时间" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="类型" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="金额" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="分类" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="交易对方" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="来源" FontWeight="SemiBold" />
          </Grid>
          <ListView x:Name="RecordsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="RecordsSelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:TransactionRecord">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="76" /><ColumnDefinition Width="105" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="194" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DateDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Column="1" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionBackground}">
                      <TextBlock Text="{x:Bind Direction}" FontWeight="SemiBold" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{x:Bind SignedAmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Direction, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=DirectionForeground}" />
                    <Border Grid.Column="3" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBackground}" BorderBrush="{Binding Category, Converter={StaticResource FinanceBrushConverter}, ConverterParameter=CategoryBorder}" BorderThickness="1">
                      <TextBlock Text="{x:Bind Category}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{x:Bind Merchant}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Merchant}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind Source}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Source}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </TabViewItem>
      <TabViewItem x:Name="DuplicateTab" Header="疑似重复（需要确认）" IsClosable="False">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Padding="12" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
              <TextBlock Text="这些记录与账本已有数据或本批次其他记录相似，默认跳过" FontWeight="SemiBold" />
              <TextBlock Text="选择一条记录并点击“仍然导入”，可保留时间和金额恰好相同的真实两笔交易。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="仍然导入所选" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ImportDuplicateClick" />
          </Grid>
          <ListView x:Name="DuplicateList" Grid.Row="1" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ImportDuplicateItem">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind IncomingDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ExistingDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Reason}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="问题与跳过" IsClosable="False">
        <ListView x:Name="IssuesList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:ImportIssue"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Source}" /><TextBlock Grid.Column="1" Text="{x:Bind RowDisplay}" /><TextBlock Grid.Column="2" Text="{x:Bind Reason}" /><TextBlock Grid.Column="3" Text="{x:Bind RawValue}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
      </TabViewItem>
    </TabView>
  </Grid>
</ContentDialog>
