<Window x:Class="DuxiuLedger.Desktop.ManualEntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="新增流水" Width="520" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="新增流水" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="手动记录一笔收入或支出" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,22,0,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="交易日期 *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><DatePicker x:Name="OccurredOnPicker" Height="38" SelectedDateFormat="Short"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="收支类型 *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="DirectionBox" Height="38" SelectedIndex="0"><ComboBoxItem Content="支出"/><ComboBoxItem Content="收入"/></ComboBox></StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,17,0,0"><TextBlock Text="金额（元）*" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="AmountBox" ToolTip="例如 38.50"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="分类" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="CategoryBox" Height="38" IsEditable="True" Text="未分类"><ComboBoxItem Content="日常餐饮"/><ComboBoxItem Content="交通出行"/><ComboBoxItem Content="住房居家"/><ComboBoxItem Content="购物消费"/><ComboBoxItem Content="医疗健康"/><ComboBoxItem Content="文化娱乐"/><ComboBoxItem Content="工资收入"/><ComboBoxItem Content="其他"/></ComboBox></StackPanel>
      <StackPanel Grid.Row="3" Margin="0,17,0,0"><TextBlock Text="交易对方" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="MerchantBox" ToolTip="商户、个人或机构"/></StackPanel>
      <StackPanel Grid.Row="4" Margin="0,17,0,0"><TextBlock Text="备注" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="NoteBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,8"/></StackPanel>
      <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="{StaticResource NegativeBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid></Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="取消" Click="CancelClick" Margin="0,0,8,0"/><Button Style="{StaticResource FluentButton}" Content="保存流水" Click="SaveClick"/></StackPanel>
  </Grid>
</Window>
