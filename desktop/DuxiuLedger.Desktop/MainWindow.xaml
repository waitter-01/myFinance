<Window x:Class="DuxiuLedger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="独秀账本" Width="1320" Height="850" MinWidth="1040" MinHeight="680" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22,16,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="6,0,0,0"><Image Source="Assets/duxiu-logo.png" Width="42" Height="42" Stretch="Uniform"/><StackPanel Margin="10,1,0,0" VerticalAlignment="Center"><TextBlock Text="独秀账本" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="本地财务中心" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,38,0,0">
          <TextBlock Text="导航" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,8"/>
          <Button x:Name="DashboardNav" Style="{StaticResource SelectedNavButton}" Tag="Dashboard" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="15" Width="26"/><TextBlock Text="总览" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="TransactionsNav" Style="{StaticResource NavButton}" Tag="Transactions" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8CB;" FontSize="15" Width="26"/><TextBlock Text="全部流水" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="BudgetsNav" Style="{StaticResource NavButton}" Tag="Budgets" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" FontSize="15" Width="26"/><TextBlock Text="预算计划" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="SubscriptionsNav" Style="{StaticResource NavButton}" Tag="Subscriptions" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D4;" FontSize="15" Width="26"/><TextBlock Text="订阅与月卡" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <TextBlock Text="管理" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="12,28,0,8"/>
          <Button x:Name="CategoriesNav" Style="{StaticResource NavButton}" Tag="Categories" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8EC;" FontSize="15" Width="26"/><TextBlock Text="分类设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="Settings" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="15" Width="26"/><TextBlock Text="偏好设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="BackupNav" Style="{StaticResource NavButton}" Tag="Backup" Click="NavigationClick"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE753;" FontSize="15" Width="26"/><TextBlock Text="数据备份" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Background="#F8F9FA" Padding="13"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource PositiveBrush}" Margin="0,0,8,0"/><TextBlock Text="本地模式" FontWeight="SemiBold" FontSize="12"/></StackPanel><TextBlock Text="数据只保存在这台电脑" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="34,26,34,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="2,0,2,22"><StackPanel><TextBlock x:Name="PageTitle" Text="总览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="查看本月财务情况和最近流水" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Content="导入账单" Click="ImportClick" Margin="0,0,8,0"/><Button Style="{StaticResource FluentButton}" Content="新增记录" Click="AddClick"/></StackPanel></Grid>

      <Grid Grid.Row="1">
        <Grid x:Name="DashboardPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本月收入" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="IncomeText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="当月全部收入" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="#E7F4EC"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74A;" Foreground="{StaticResource PositiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本月支出" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="ExpenseText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="当月全部支出" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="#F8ECEA"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74B;" Foreground="{StaticResource NegativeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本月结余" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="BalanceText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="收入减去支出" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,0,14"><TextBlock Text="最近流水" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="DashboardGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding OccurredOn, StringFormat=yyyy-MM-dd HH:mm}" Width="155"/><DataGridTextColumn Header="类型" Binding="{Binding Direction}" Width="72"/><DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="105"/><DataGridTextColumn Header="交易对方" Binding="{Binding Merchant}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="160"/></DataGrid.Columns></DataGrid></Grid></Border>
        </Grid>

        <Grid x:Name="TransactionsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="2,0,2,16"><StackPanel><TextBlock Text="流水明细" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="支持按商户或备注快速查找" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="230" ToolTip="输入商户或备注"/><Button Style="{StaticResource SecondaryButton}" Content="搜索" Click="SearchClick" Margin="8,0,0,0"/></StackPanel></Grid><DataGrid Grid.Row="1" x:Name="TransactionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding OccurredOn, StringFormat=yyyy-MM-dd HH:mm}" Width="155"/><DataGridTextColumn Header="类型" Binding="{Binding Direction}" Width="72"/><DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="105"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="交易对方" Binding="{Binding Merchant}" Width="*"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150"/></DataGrid.Columns></DataGrid></Grid></Border></Grid>

        <Grid x:Name="BudgetsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><Grid><StackPanel><TextBlock Text="本月预算" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="为各类支出设置上限，掌握消费节奏" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Style="{StaticResource SecondaryButton}" Content="新建预算" HorizontalAlignment="Right"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource SubtleBrush}"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" FontSize="22" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="还没有预算计划" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="创建预算后，可以在这里查看使用进度" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border></Grid>

        <Grid x:Name="SubscriptionsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="本月已付" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="SubscriptionCurrentMonthText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="本月识别出的订阅支出" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="每月分摊" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="SubscriptionMonthlyAverageText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="近 12 个月总额 ÷ 12" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="订阅项目" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="SubscriptionProviderCountText" Text="0 项" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="按交易对方合并统计" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,0,14"><TextBlock Text="订阅成本明细" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SubscriptionHintText" Text="根据偏好设置中的关键词自动识别；近 12 个月付款会均摊到每个月。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="SubscriptionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="订阅项目" Binding="{Binding Merchant}" Width="*"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="付款次数" Binding="{Binding PaymentCount}" Width="100"/><DataGridTextColumn Header="近12个月付款" Binding="{Binding PaidLast12Months, StringFormat=¥{0:N2}}" Width="140"/><DataGridTextColumn Header="月均分摊" Binding="{Binding MonthlyAverage, StringFormat=¥{0:N2}}" Width="125"/><DataGridTextColumn Header="最近付款" Binding="{Binding LatestPayment, StringFormat=yyyy-MM-dd}" Width="120"/></DataGrid.Columns></DataGrid></Grid></Border>
        </Grid>

        <Grid x:Name="CategoriesPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="分类管理" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="整理收入和支出分类" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Style="{StaticResource SecondaryButton}" Content="添加分类" HorizontalAlignment="Right"/></Grid><UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top"><Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,0,8,8"><StackPanel><TextBlock Text="日常餐饮" FontWeight="SemiBold"/><TextBlock Text="支出分类" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="8,0,0,8"><StackPanel><TextBlock Text="交通出行" FontWeight="SemiBold"/><TextBlock Text="支出分类" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,8,8,0"><StackPanel><TextBlock Text="工资收入" FontWeight="SemiBold"/><TextBlock Text="收入分类" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="8,8,0,0"><StackPanel><TextBlock Text="其他" FontWeight="SemiBold"/><TextBlock Text="通用分类" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid></Grid></Border></Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="消费与预算" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="这些参数会参与后续的消费分析和建议，不会被程序写死。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="小额消费上限（元）" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="SmallExpenseThresholdBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="月度总预算（元，0 表示未设置）" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="MonthlyBudgetBox"/></StackPanel></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="提醒计划" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="先保存提醒偏好；系统通知功能将在后续版本接入。时间格式为 HH:mm。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="DailyReminderCheck" Content="启用每日提醒" FontWeight="SemiBold"/><TextBox x:Name="DailyReminderTimeBox" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="2"><CheckBox x:Name="WeeklySummaryCheck" Content="启用每周总结" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><ComboBox x:Name="WeeklySummaryDayBox" Width="130" Height="38"/><TextBox x:Name="WeeklySummaryTimeBox" Width="120" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="订阅消费识别" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="商户、分类或备注中包含任一关键词时，会计入订阅与月卡统计。使用英文逗号或中文逗号分隔。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBox x:Name="SubscriptionKeywordsBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="11,9"/><Button Style="{StaticResource FluentButton}" Content="保存设置" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SaveSettingsClick"/></StackPanel></Border>
        </StackPanel></ScrollViewer></Grid>

        <Grid x:Name="BackupPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Padding="24"><StackPanel Width="520" HorizontalAlignment="Left"><Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE753;" FontSize="21" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="保护你的本地数据" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="账本数据保存在本机 SQLite 文件中。建议定期复制到安全位置。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,22"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource FluentButton}" Content="立即备份" Click="BackupClick" Margin="0,0,8,0"/><Button Style="{StaticResource SecondaryButton}" Content="打开数据目录" Click="OpenDataFolderClick"/></StackPanel><TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border></Grid>
      </Grid>

      <DockPanel Grid.Row="2" Margin="2,13,2,0"><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="独秀账本 · 本地优先" Foreground="{StaticResource MutedBrush}" FontSize="11"/></DockPanel>
    </Grid>
  </Grid>
</Window>
