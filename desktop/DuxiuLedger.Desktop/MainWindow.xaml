<Window x:Class="DuxiuLedger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="独秀指数基础账本" Width="1180" Height="760" MinWidth="900" MinHeight="600" Background="{StaticResource WindowBrush}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><StackPanel DockPanel.Dock="Left"><TextBlock Text="独秀指数基础账本" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="本地保存 · 随时导入 · 自动去重" Foreground="#718096" Margin="0,6,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="导入账单" Click="ImportClick"/><Button Content="新增记录" Click="AddClick" Background="#0F766E"/></StackPanel></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="全部流水" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="220" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="搜索商户或备注"/><Button Content="搜索" Click="SearchClick"/></StackPanel></Grid>
    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="12"><DataGrid x:Name="LedgerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding OccurredOn, StringFormat=yyyy-MM-dd HH:mm}" Width="170"/><DataGridTextColumn Header="类型" Binding="{Binding Direction}" Width="80"/><DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="110"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="交易对方" Binding="{Binding Merchant}" Width="*"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="170"/></DataGrid.Columns></DataGrid></Border>
    <TextBlock x:Name="StatusText" Grid.Row="3" Text="准备就绪" Foreground="#718096" Margin="4,14,0,0"/>
  </Grid>
</Window>
