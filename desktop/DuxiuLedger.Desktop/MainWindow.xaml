<Window x:Class="DuxiuLedger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="独秀指数基础账本" Width="1280" Height="820" MinWidth="1000" MinHeight="650" Background="{StaticResource PageBrush}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="20,28,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}"><TextBlock Text="独" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="独秀账本" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Personal finance" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,44,0,0"><TextBlock Text="工作区" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="12,0,0,12"/><Button Style="{StaticResource QuietButton}" Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}" Content="  总览"/><Button Style="{StaticResource QuietButton}" Content="  全部流水"/><Button Style="{StaticResource QuietButton}" Content="  预算计划"/><TextBlock Text="管理" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="12,32,0,12"/><Button Style="{StaticResource QuietButton}" Content="  分类设置"/><Button Style="{StaticResource QuietButton}" Content="  数据备份"/></StackPanel>
        <Border Grid.Row="2" Background="#F4F7FB" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="本地数据" FontWeight="SemiBold"/><TextBlock Text="数据仅保存在这台电脑" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,12"/><TextBlock Text="SQLite · 自动去重" Foreground="{StaticResource AccentBrush}" FontSize="12"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="40,32,40,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="全部流水" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="记录你的每一笔收入与支出" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="导入账单" Click="ImportClick"/><Button Content="＋  新增记录" Click="AddClick" Background="{StaticResource GreenBrush}" Margin="0"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,28,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="本月收入" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="IncomeText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#0F766E"/><TextBlock Text="已保存流水" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="本月支出" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExpenseText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#C2413A"/><TextBlock Text="可按商户搜索" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="当前结余" Foreground="#DCE8FF"/><TextBlock x:Name="BalanceText" Text="¥0.00" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="White"/><TextBlock Text="收入减去支出" FontSize="12" Foreground="#DCE8FF" Margin="0,8,0,0"/></StackPanel></Border></Grid>
      <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="最近流水" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="220" ToolTip="搜索商户或备注"/><Button Content="搜索" Click="SearchClick" Margin="8,0,0,0"/></StackPanel></Grid><DataGrid Grid.Row="1" x:Name="LedgerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding OccurredOn, StringFormat=yyyy-MM-dd HH:mm}" Width="170"/><DataGridTextColumn Header="类型" Binding="{Binding Direction}" Width="80"/><DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥{0:N2}}" Width="110"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="交易对方" Binding="{Binding Merchant}" Width="*"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="170"/></DataGrid.Columns></DataGrid></Grid></Border>
      <DockPanel Grid.Row="3" Margin="4,14,0,0"><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{StaticResource MutedBrush}"/><TextBlock DockPanel.Dock="Right" Text="本地模式" Foreground="{StaticResource MutedBrush}"/></DockPanel>
    </Grid>
  </Grid>
</Window>
