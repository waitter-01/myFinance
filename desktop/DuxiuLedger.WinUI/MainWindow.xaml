<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuxiuLedger.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:DuxiuLedger.Desktop.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="独秀账本"
    mc:Ignorable="d">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>

  <Grid AllowDrop="True" DragOver="ScreenshotDragOver" Drop="ScreenshotDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="独秀账本" Subtitle="个人财务中心" IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBarPaneToggleRequested">
      <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/duxiu-logo.png" ShowAsMonochrome="False" /></TitleBar.IconSource>
    </TitleBar>

    <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="232" SelectionChanged="NavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="总览" Tag="Dashboard" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="全部流水" Tag="Transactions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8CB;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="消费洞察" Tag="Insights"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="预算计划" Tag="Budgets"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="订阅与月卡" Tag="Subscriptions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="账户管理" Tag="Accounts"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="分类设置" Tag="Categories"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="数据备份" Tag="Backup"><NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="偏好设置" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid Padding="32,24,32,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
          <StackPanel><TextBlock x:Name="PageTitle" Text="总览" Style="{StaticResource PageTitleStyle}" /><TextBlock x:Name="PageSubtitle" Text="查看本月财务情况和最近流水" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="导入表格" Click="ImportClick" /><Button Content="识别账单截图" Click="ScreenshotImportClick" /><Button Content="粘贴截图" ToolTipService.ToolTip="从剪贴板粘贴图片，快捷键 Ctrl+V" Click="PasteScreenshotClick"><Button.KeyboardAccelerators><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteScreenshotAcceleratorInvoked" /></Button.KeyboardAccelerators></Button><Button Content="新增记录" Style="{StaticResource AccentButtonStyle}" Click="AddClick" /></StackPanel>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1" Margin="0,22,0,0">
          <Grid x:Name="DashboardPage">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock Text="本月收入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="IncomeText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock Text="本月净支出" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ExpenseText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="支出扣除退款与报销" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,5,0,0" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock Text="本月结余" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BalanceText" Text="¥0.00" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="最近流水" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="RecordCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" /></StackPanel><ListView x:Name="RecentList" Grid.Row="1" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:TransactionRecord"><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="72" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind DateDisplay}" /><TextBlock Grid.Column="1" Text="{x:Bind Direction}" /><TextBlock Grid.Column="2" Text="{x:Bind AmountDisplay}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="{x:Bind Merchant}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" Text="{x:Bind Source}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
          </Grid>

          <Grid x:Name="TransactionsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBox x:Name="SearchBox" Width="280" HorizontalAlignment="Left" PlaceholderText="搜索商户、分类、账户或备注" /><Button Content="搜索" HorizontalAlignment="Left" Margin="290,0,0,0" Click="SearchClick" /></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><ListView x:Name="TransactionsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:TransactionRecord"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,10"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="60" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind DateDisplay}" /><TextBlock Grid.Column="1" Text="{x:Bind Direction}" /><TextBlock Grid.Column="2" Text="{x:Bind AmountDisplay}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="{x:Bind Category}" /><TextBlock Grid.Column="4" Text="{x:Bind AccountDisplay}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="5" Text="{x:Bind Merchant}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="6" Text="{x:Bind Note}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"><Button Content="编辑" Tag="{x:Bind}" Click="EditTransactionClick" /><Button Content="删除" Tag="{x:Bind}" Click="DeleteTransactionClick" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>

          <ScrollViewer x:Name="InsightsPage" Visibility="Collapsed"><StackPanel Spacing="14"><Grid><StackPanel><TextBlock Text="本月消费画像" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="分析规则可以在偏好设置中调整" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Content="导出本月 CSV" HorizontalAlignment="Right" Click="ExportMonthlyReportClick" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="小额消费" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="InsightSmallText" Text="¥0.00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock x:Name="InsightSmallDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="系统建议可减少" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="InsightOptionalText" Text="¥0.00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock x:Name="InsightOptionalDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="最大支出分类" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="InsightTopCategoryText" Text="暂无数据" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="InsightTopCategoryDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="下月建议额度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="InsightBudgetText" Text="¥0" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock x:Name="InsightBudgetDetailText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" /></StackPanel></Border></Grid><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="分类排行" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="本月支出按详细分类汇总" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,10" /><ListView x:Name="CategoryRankingList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:SpendingRankItem"><Grid Padding="6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="95" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="2" Text="{x:Bind AmountDisplay}" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{x:Bind ShareDisplay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="商户排行" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="找出消费最集中的交易对象" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,10" /><ListView x:Name="MerchantRankingList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:SpendingRankItem"><Grid Padding="6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="95" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{x:Bind CountDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="2" Text="{x:Bind AmountDisplay}" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{x:Bind ShareDisplay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></Grid><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="近 6 个月趋势" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" /><ListView x:Name="MonthlyTrendList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:MonthlyTrendItem"><Grid Padding="6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Month}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind IncomeDisplay}" /><TextBlock Grid.Column="2" Text="{x:Bind ExpenseDisplay}" /><TextBlock Grid.Column="3" Text="{x:Bind BalanceDisplay}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="本月建议" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="系统按你设置的分类范围给出建议" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,10" /><ListView x:Name="InsightSuggestionsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:InsightSuggestion"><StackPanel Padding="6" Spacing="3"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel></ScrollViewer>

          <ScrollViewer x:Name="BudgetsPage" Visibility="Collapsed"><StackPanel Spacing="14"><Grid><StackPanel><TextBlock Text="预算与储蓄目标" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="总预算在偏好设置中调整，分类预算用于控制具体去向" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><CalendarDatePicker x:Name="BudgetMonthPicker" Width="170" PlaceholderText="选择月份" DateChanged="BudgetMonthChanged" /><Button Content="新增分类预算" Style="{StaticResource AccentButtonStyle}" Click="AddBudgetClick" /></StackPanel></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="月度总预算" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BudgetTotalText" Text="未设置" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /><ProgressBar x:Name="BudgetTotalProgress" Margin="0,10,0,0" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="本月已支出" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BudgetSpentText" Text="¥0.00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="预算剩余" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BudgetRemainingText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border></Grid><Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel><TextBlock Text="分类预算进度" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" /><ListView x:Name="BudgetsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:BudgetRecord"><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Category}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind AmountDisplay}" /><TextBlock Grid.Column="2" Text="{x:Bind SpentDisplay}" /><ProgressBar Grid.Column="3" Maximum="1" Value="{x:Bind Progress}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{x:Bind RemainingDisplay}" HorizontalAlignment="Right" /><Button Grid.Column="5" Content="删除" Tag="{x:Bind}" Click="DeleteBudgetClick" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel><Grid Margin="2,0,0,8"><TextBlock Text="储蓄目标" Style="{StaticResource SectionTitleStyle}" /><Button Content="新增目标" HorizontalAlignment="Right" Click="AddSavingsGoalClick" /></Grid><ListView x:Name="SavingsGoalsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:SavingsGoalRecord"><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind TargetDateDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind TargetDisplay}" /><TextBlock Grid.Column="2" Text="{x:Bind SavedDisplay}" /><ProgressBar Grid.Column="3" Maximum="1" Value="{x:Bind Progress}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{x:Bind MonthlyRequiredDisplay}" HorizontalAlignment="Right" /><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"><Button Content="编辑" Tag="{x:Bind}" Click="EditSavingsGoalClick" /><Button Content="删除" Tag="{x:Bind}" Click="DeleteSavingsGoalClick" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel></ScrollViewer>

          <Grid x:Name="SubscriptionsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid ColumnSpacing="12" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="本月已付" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SubscriptionCurrentText" Text="¥0.00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="当前月均负担" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SubscriptionAverageText" Text="¥0.00" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="各项目最近价格 ÷ 覆盖月数" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="订阅项目" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SubscriptionCountText" Text="0 项" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><ListView x:Name="SubscriptionsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:SubscriptionSummary"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="80" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Merchant}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind Category}" /><TextBlock Grid.Column="2" Text="{x:Bind PaymentCount}" /><TextBlock Grid.Column="3" Text="{x:Bind PaidDisplay}" /><TextBlock Grid.Column="4" Text="{x:Bind BillingCycleDisplay}" /><TextBlock Grid.Column="5" Text="{x:Bind MonthlyAverageDisplay}" /><TextBlock Grid.Column="6" Text="{x:Bind LatestPaymentDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>

          <Grid x:Name="AccountsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="我的账户" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="余额由期初余额和已关联流水自动计算" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" /></StackPanel><Button Content="新增账户" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="AddAccountClick" /></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><ListView x:Name="AccountsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:AccountRecord"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="130" /><ColumnDefinition Width="140" /><ColumnDefinition Width="90" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind Type}" /><TextBlock Grid.Column="2" Text="{x:Bind OpeningBalanceDisplay}" /><TextBlock Grid.Column="3" Text="{x:Bind CurrentBalanceDisplay}" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{x:Bind StatusDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"><Button Content="编辑" Tag="{x:Bind}" Click="EditAccountClick" /><Button Content="删除" Tag="{x:Bind}" Click="DeleteAccountClick" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>

          <Grid x:Name="CategoriesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="收支分类" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="预设分类可以自由修改；停用后不再出现在录入选项中" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" /></StackPanel><Button Content="新增分类" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="AddCategoryClick" /></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><ListView x:Name="CategoriesList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:CategoryRecord"><Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="100" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind Type}" /><TextBlock Grid.Column="2" Text="{x:Bind SortOrder}" /><TextBlock Grid.Column="3" Text="{x:Bind UsageDisplay}" /><TextBlock Grid.Column="4" Text="{x:Bind StatusDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"><Button Content="编辑" Tag="{x:Bind}" Click="EditCategoryClick" /><Button Content="删除" Tag="{x:Bind}" Click="DeleteCategoryClick" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>

          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14"><Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="12"><TextBlock Text="消费与预算" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="所有参数保存在本机，可随时修改。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="SmallExpenseThresholdBox" Header="小额消费上限（元）" Minimum="0" SpinButtonPlacementMode="Compact" /><NumberBox x:Name="MonthlyBudgetBox" Grid.Column="1" Header="月度总预算（元，0 表示未设置）" Minimum="0" SpinButtonPlacementMode="Compact" /></Grid><TextBox x:Name="OptionalCategoriesBox" Header="系统建议可减少的分类（逗号分隔）" PlaceholderText="例如：零食饮料,娱乐休闲,游戏消费" /></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="12"><TextBlock Text="提醒计划" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="保存后使用 Windows 任务计划，即使应用未打开也能按时提醒。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="8"><CheckBox x:Name="DailyReminderCheck" Content="启用每日提醒" /><TimePicker x:Name="DailyReminderTimePicker" ClockIdentifier="24HourClock" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><CheckBox x:Name="WeeklySummaryCheck" Content="启用每周总结" /><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="WeeklySummaryDayBox" Width="130" /><TimePicker x:Name="WeeklySummaryTimePicker" ClockIdentifier="24HourClock" /></StackPanel></StackPanel></Grid><Button Content="发送测试通知" HorizontalAlignment="Left" Click="TestNotificationClick" /></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="12"><TextBlock Text="订阅消费识别" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="商户、分类或备注中包含任一关键词时，会计入订阅统计。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBox x:Name="SubscriptionKeywordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /><Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveSettingsClick" /></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="12"><TextBlock Text="MySQL 多端同步" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="本地优先双向合并。密码使用 Windows DPAPI 加密，不会写入源码或日志。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="18"><CheckBox x:Name="MySqlSyncEnabledCheck" Content="启用 MySQL 同步" /><CheckBox x:Name="SyncOnStartupCheck" Content="启动后自动同步" /></StackPanel><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBox x:Name="MySqlHostBox" Header="服务器地址" /><NumberBox x:Name="MySqlPortBox" Grid.Column="1" Header="端口" Minimum="1" Maximum="65535" Value="3306" SpinButtonPlacementMode="Compact" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="MySqlDatabaseBox" Header="数据库名" /><TextBox x:Name="MySqlUsernameBox" Grid.Column="1" Header="用户名" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><PasswordBox x:Name="MySqlPasswordBox" Header="密码（留空表示保持已保存密码）" PasswordRevealMode="Peek" /><ComboBox x:Name="MySqlSslModeBox" Grid.Column="1" Header="TLS 模式" /></Grid><CheckBox x:Name="MySqlLegacyModeCheck" Content="MySQL 5.x 旧版兼容模式（禁用 TLS，使用 utf8）" /><InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Message="旧版兼容模式会明文传输数据库凭据和账本数据，仅在无法升级服务器且网络可信时使用。" /><ProgressRing x:Name="CloudSyncProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" /><InfoBar x:Name="CloudSyncInfo" IsOpen="False" IsClosable="True" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存并测试连接" Click="TestMySqlClick" /><Button Content="立即双向同步" Style="{StaticResource AccentButtonStyle}" Click="SyncNowClick" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>

          <Border x:Name="BackupPage" Style="{StaticResource CardStyle}" Padding="28" Visibility="Collapsed"><StackPanel Width="560" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="12"><FontIcon Glyph="&#xE753;" FontSize="30" HorizontalAlignment="Left" /><TextBlock Text="保护你的本地数据" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="账本数据保存在本机 SQLite 文件中，建议定期复制到安全位置。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="立即备份" Style="{StaticResource AccentButtonStyle}" Click="BackupClick" /><Button Content="打开数据目录" Click="OpenDataFolderClick" /></StackPanel><TextBlock x:Name="DataPathText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>

          <Border x:Name="PlaceholderPage" Style="{StaticResource CardStyle}" Padding="24" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE946;" FontSize="32" /><TextBlock x:Name="PlaceholderTitle" Text="页面建设中" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="该模块将在后续开发中接入。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="WinUI 3 · 本地优先" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="2,12,0,0" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
